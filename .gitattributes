# Нормализуем окончания строк: в репозитории и в рабочей копии — LF.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.qss text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.sql text eol=lf

# Windows-скрипты должны оставаться с CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Бинарные файлы не трогаем.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary

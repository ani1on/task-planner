# Server
APP_NAME=task-planner
APP_ENV=development
APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (значения совпадают с docker-compose.yml)
POSTGRES_USER=task_planner
POSTGRES_PASSWORD=task_planner
POSTGRES_DB=task_planner
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://task_planner:task_planner@localhost:5432/task_planner

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Reminders worker
REMINDERS_WORKER_ENABLED=False
REMINDERS_WORKER_INTERVAL_SECONDS=60

# Email (SMTP). Если SMTP_HOST не задан, письма не отправляются.
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@task-planner.local
SMTP_USE_TLS=True
